# Configuracion del sitio en Apache (hosting VacaWeb).
# Este archivo viaja dentro de public/, asi que el build lo copia a out/ y
# sube junto con el resto. Aqui vive lo que antes hacia el servidor de Next:
# cabeceras de seguridad, cache, compresion y pagina de error.

# ----------------------------------------------------------------------
# 1. Siempre por HTTPS y sin www
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ----------------------------------------------------------------------
# 2. Cabeceras de seguridad
#    Las mismas que traia next.config.ts. La politica de contenido permite
#    los marcos de Google (por si se vuelve a incrustar un mapa) y las
#    teselas de OpenStreetMap que usa el mapa de la seccion de ubicacion.
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'self'; frame-src 'self' https://www.google.com; form-action 'self'; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.tile.openstreetmap.org; upgrade-insecure-requests"
</IfModule>

# ----------------------------------------------------------------------
# 3. Cache
#    Los archivos con huella en el nombre (los de _next/static y las
#    variantes de imagen) no cambian nunca: se guardan un ano. El HTML se
#    revisa en cada visita para que un cambio se vea de inmediato.
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(webp|avif|jpg|jpeg|png|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(html|json|xml)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# 4. Compresion
#    El texto viaja comprimido; las imagenes y el video ya lo estan.
# ----------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# 5. Tipos de archivo
#    Algunos servidores no reconocen estos por su cuenta.
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
  AddType font/woff2 .woff2
  AddType video/mp4 .mp4
</IfModule>

# ----------------------------------------------------------------------
# 6. Pagina de error
# ----------------------------------------------------------------------
ErrorDocument 404 /404.html

# ----------------------------------------------------------------------
# 7. Listado de carpetas apagado
# ----------------------------------------------------------------------
Options -Indexes
